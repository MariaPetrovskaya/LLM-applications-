    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = items[0].json;\n\n// The AI Agent returns its answer in \"output\", not \"response\"\nconst agentOutput = (result.output || '').trim();\n\n// Phrases the agent uses when it finds nothing\nconst noResultPhrases = [\n  'не найден',\n  'не нашел',\n  'не нашёл', \n  'нет информации',\n  'нет данных',\n  'не содержит',\n  'не могу найти',\n  'отсутствует',\n  'не располагаю',\n  'не удалось найти',\n];\n\nconst lowerOutput = agentOutput.toLowerCase();\nconst foundNoResult = noResultPhrases.some(phrase => lowerOutput.includes(phrase));\n\nconst hasResults = agentOutput.length > 30 && !foundNoResult;\n\nreturn [{\n  json: {\n    ...result,\n    hasResults,\n    agentOutputPreview: agentOutput.slice(0, 100),\n  }\n}];"
      },
