      "parameters": {
        "jsCode": "// Нормализация запроса\nconst userQuery = $('Edit Fields').item.json.message.text || '';\n\nlet normalizedQuery = userQuery\n  .toLowerCase()\n  .replace(/[^\\w\\u0400-\\u04FF\\s]/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst hrKeywords = ['правила', 'документы', 'персонал', 'инструкция', 'памятка', 'сотрудники'];\nconst hasHRTerms = hrKeywords.some(keyword => normalizedQuery.includes(keyword));\n\nif (!hasHRTerms && normalizedQuery) {\n  normalizedQuery += ' интересуют правила инструкции сотрудники';\n}\n\nconsole.log('Original query:', userQuery);\nconsole.log('Normalized query:', normalizedQuery);\n\nreturn [{\n  json: {\n    ...$input.all()[0].json,\n    search_query: normalizedQuery\n  }\n}];"
      },
