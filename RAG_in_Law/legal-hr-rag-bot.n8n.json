      "parameters": {
        "jsCode": "// Обработка результатов из Pinecone\nconst items = $input.all();\n\nconsole.log('=== DEBUG PINE CONE RESULTS ===');\nconsole.log('Total items:', items.length);\n\nif (items.length === 0) {\n  return [{ \n    json: { \n      telegram_message: '❌ Ссылки на документы ❌\\n\\nПо вашему запросу ничего не найдено.',\n      telegram_parse_mode: 'HTML'\n    } \n  }];\n}\n\nlet message = '<b>🔍 Ссылки на документы</b>\\n\\n';\nmessage += `Найдено результатов: <b>${items.length}</b>\\n\\n`;\n\nitems.forEach((item, index) => {\n  const document = item.json?.document || {};\n  const metadata = document.metadata || {};\n  const pageContent = document.pageContent || '';\n  \n  const cleanText = (text) => {\n    if (!text) return '';\n    return text\n      .replace(/&/g, '&amp;')\n      .replace(/</g, '&lt;')\n      .replace(/>/g, '&gt;')\n      .replace(/\"/g, '&quot;')\n      .replace(/'/g, '&#039;');\n  };\n  \n  let title = '';\n  if (metadata.meaning) {\n    title = cleanText(metadata.meaning);\n  } else if (metadata.filename) {\n    title = cleanText(metadata.filename);\n  } else {\n    title = `Документ ${index + 1}`;\n  }\n  \n  // Создаем уникальный идентификатор для ссылки\n  const resultId = `result_${index}`;\n  \n  message += `<b>${index + 1}. ${title}</b>\\n`;\n  \n  // Если есть ссылка на оригинальный документ\n  if (metadata.link) {\n    const cleanLink = metadata.link.replace(/[<>]/g, '');\n    message += `<a href=\"${cleanLink}\">📎 Открыть документ</a>\\n\\n`;\n  } else {\n    // Краткое описание\n    if (pageContent) {\n      const preview = cleanText(pageContent).substring(0, 150);\n      message += `${preview}${pageContent.length > 150 ? '...' : ''}\\n\\n`;\n    } else {\n      message += '<i>Нет доступного содержимого</i>\\n\\n';\n    }\n  }\n});\n\nif (message.length > 4096) {\n  message = message.substring(0, 4000) + '\\n\\n... <i>(сообщение сокращено)</i>';\n}\n\nreturn [{ \n  json: { \n    telegram_message: message,\n    telegram_parse_mode: 'HTML'\n  } \n}];"
      },
